{
  "name": "ai-arena-operator-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8787",
    "build": "tsc -b && vite build && node scripts/assert-http-build.mjs",
    "build:http": "VITE_CONSOLE_DATA_MODE=http VITE_API_BASE_PATH=/api npm run build",
    "build:mock": "VITE_CONSOLE_DATA_MODE=mock tsc -b && VITE_CONSOLE_DATA_MODE=mock vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "test:formatting": "node scripts/run-formatting-tests.mjs",
    "test:api": "node scripts/run-api-contract-tests.mjs",
    "test:world-chat": "node scripts/run-world-chat-tests.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
